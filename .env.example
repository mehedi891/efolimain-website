# eFoli (Next.js) — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel Project Settings
# (Production / Preview / Development). All are SERVER-ONLY — never prefix with
# NEXT_PUBLIC_.

# ── Contact form (nodemailer + hCaptcha) ──────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="app@efoli.com"
SMTP_PASS="your-gmail-app-password"
HCAPTCHA_SECRET_KEY="your-hcaptcha-secret"

# ── Blog CMS (cms.efoli.com) ──────────────────────────────────────────────
# Any of these forms works (see data/blogPosts.ts resolvePublicApiBase):
#   https://cms.efoli.com  |  https://cms.efoli.com/api  |  .../api/public
CMS_API_URL="https://cms.efoli.com/api"
CMS_SITE="efoli"

# ── Careers (easy.jobs) ───────────────────────────────────────────────────
EASYJOBS_API_KEY="your-easyjobs-api-key"
# Optional overrides (defaults are usually fine):
# EASYJOBS_API_URL="https://app.easy.jobs/api/v1"
# EASYJOBS_PLUGIN_VERSION="2.8.1"

# ── CMS on-demand revalidation + draft preview ────────────────────────────
REVALIDATE_SECRET="generate-a-long-random-string"
PREVIEW_SECRET="generate-a-long-random-string"

# ── Free-tools lead store (MongoDB Atlas) ─────────────────────────────────
# Connection string from Atlas → Connect → Drivers. If unset, lead capture is
# skipped silently (the tools still email reports & reveal results).
MONGODB_URI="mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Optional — database name (defaults to "efoli"):
# MONGODB_DB="efoli"

# ── Admin panel (/admin) ──────────────────────────────────────────────────
# Long random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET="generate-a-long-random-string"
# Seed an admin user (bcrypt-hashed) with:
#   node --env-file=.env.local --experimental-strip-types scripts/seed-admin.mts <email> <password>
